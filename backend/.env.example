# Server Port Configuration
PORT=5000

# High-Value Reorder Approval Threshold (in USD)
HIGH_VALUE_THRESHOLD=500.00

# Redis Configuration for BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL Database Connection (Optional if using PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory_db
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=inventory_db
